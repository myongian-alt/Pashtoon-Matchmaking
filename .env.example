# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Get these from: https://app.supabase.com → Project Settings → API Keys
# The app itself reads the EXPO_PUBLIC_ versions (Expo inlines EXPO_PUBLIC_*
# into the client bundle automatically - no extra config needed). The
# unprefixed copies are only for the Node-only deploy scripts.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Only needed for admin operations (migrations, etc.)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
